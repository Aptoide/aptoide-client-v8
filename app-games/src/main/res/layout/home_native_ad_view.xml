<?xml version="1.0" encoding="utf-8"?>
<!--
  Manual MAX native template for the Games home feed bundle.
  Colors come from res/values/colors.xml (home_native_ad_*); the accent is brand-specific via src/vanilla.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/home_native_ad_card_background"
    android:orientation="vertical">

  <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="180dp">

    <FrameLayout
        android:id="@+id/home_native_ad_media"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/home_native_ad_media_background" />

    <TextView
        android:id="@+id/home_native_ad_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:background="@color/home_native_ad_badge_background"
        android:fontFamily="@font/chakrapetch_bold"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:text="@string/home_native_ad_badge"
        android:textColor="@color/home_native_ad_accent"
        android:textSize="11sp" />

    <FrameLayout
        android:id="@+id/home_native_ad_options"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="8dp" />
  </FrameLayout>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:padding="12dp">

    <ImageView
        android:id="@+id/home_native_ad_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

      <TextView
          android:id="@+id/home_native_ad_title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:fontFamily="@font/roboto_medium"
          android:maxLines="1"
          android:textColor="@color/home_native_ad_text_primary"
          android:textSize="16sp"
          tools:text="Advertiser game title" />

      <TextView
          android:id="@+id/home_native_ad_body"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:ellipsize="end"
          android:fontFamily="@font/chakrapetch_regular"
          android:maxLines="2"
          android:textColor="@color/home_native_ad_text_secondary"
          android:textSize="12sp"
          tools:text="Body copy from the native payload." />

      <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:gravity="center_vertical"
          android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/home_native_ad_stars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/home_native_ad_advertiser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/chakrapetch_regular"
            android:maxLines="1"
            android:textColor="@color/home_native_ad_text_secondary"
            android:textSize="11sp"
            tools:text="Advertiser" />
      </LinearLayout>
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/home_native_ad_cta"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:background="@color/home_native_ad_accent"
        android:fontFamily="@font/chakrapetch_bold"
        android:minWidth="0dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:stateListAnimator="@null"
        android:textAllCaps="false"
        android:textColor="@color/home_native_ad_on_accent"
        android:textSize="16sp"
        tools:text="Install" />
  </LinearLayout>
</LinearLayout>
